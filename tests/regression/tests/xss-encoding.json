        "option_list": "x_list"
      },
      {
        "name": "x_calc",
        "type": "calculate",
        "label": "Calculation with closing tags",
        "calculation": "concat('XSS11 </textarea><img src=x data-xss=11>', ' &lt;')"
      },
      {
        "name": "x_props",
        "type": "string",
        "label": "Properties with quotes",
        "hint": "XSS14 &lt;b&gt; stays as typed & </textarea><img src=x data-xss=14>",
        "constraint": ". != 'XSS12\" data-xss=\"12'",
        "appearance": "XSS13\" data-xss=\"13"
      },
      {
        "name": "x_note",
        "type": "note",
        "label": "XSS16 &lt;img src=x data-xss=16 onerror=&quot;(window.__xss=window.__xss||[]).push(16)&quot;&gt;"
      },
      {
        "name": "x_note2",
        "type": "note",
        "label": "XSS17 &amp;lt;img src=x data-xss=17 onerror=(window.__xss=window.__xss||[]).push(17)&amp;gt;"
      },
      {
        "name": "x_note3",
        "type": "note",
        "label": "XSS18 &amp;amp;lt;img src=x data-xss=18 onerror=(window.__xss=window.__xss||[]).push(18)&amp;amp;gt;"
      },
      {
        "name": "x_markup",
        "type": "note",
        "label": "XSS19 **bold** and <b>tag</b> stay formatted, A & B and 1 < 2 stay as typed"
      },
      {
        "name": "x_note4",
        "type": "note",
        "label": "XSS20 &lt;/textarea&gt;&lt;b data-xss=20&gt;breakout&lt;/b&gt;"
      }
    ]
  },
