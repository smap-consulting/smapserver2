{
  "name": "xss-encoding",
  "description": "Submitted text, choice labels, device ids, record ids and task names containing HTML are shown as text and never run as markup, on the console table, the record view, the analysis page, the monitor page, My Work, the survey editor, the webform, the translation page and the change history, while label markup that is allowed still works. Each payload records itself in window.__xss if it runs and tags any element it makes, or breaks into, with data-xss. Guards the prop-smapserver encoding fixes dc8db8e99, bf273a49f and 90eff91f4, and the server encoding of console data (getSafeText, a9cb9739f) that the console relies on. The editor, webform, translation and change history pages guard 634d013cb, 5dcf406b0 and ff1f25b45.",
  "kind": "xss",
  "survey": {
    "name": "XSS regression test",
    "project": "A project",
    "choices": {
      "x_list": [
        {
          "value": "c1",
          "label": "XSS6 <img src=x data-xss=6 onerror=\"(window.__xss=window.__xss||[]).push(6)\">"
        },
        {
          "value": "c2",
          "label": "XSS7\" data-xss=\"7"
        },
        {
          "value": "c3",
          "label": "XSS15 </textarea><img src=x data-xss=15>"
        }
      ]
    },
    "questions": [
