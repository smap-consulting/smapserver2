      {
        "name": "x_close",
        "type": "string",
        "label": "Closing tags that would end a textarea or cell"
      },
      {
        "name": "x_lead",
        "type": "string",
        "label": "Text that starts with a tag"
      },
      {
        "name": "x_media",
        "type": "string",
        "label": "Media link with a quote"
      },
      {
        "name": "x_choice",
        "type": "select1",
