{
  "name": "update-conflicts",
  "description": "Saves of a record made from a version that somebody else has since replaced (smapserver2, conflicting update merge, 2026-11-12). Each answer is merged three ways: an answer the saver left as it was keeps the other change, and an answer both changed is a conflict the saver wins, recorded in the record's history and reviewed there. Repeat rows are matched by their hidden _row_id, or by their answers without one. Console edits make a new version so a device's later save does not undo them. Saves are posted as a device posts them, so the version opened can be chosen. Each run adds new records to the test's own surveys, one per scenario, which are kept.",
  "kind": "update-conflict",
  "survey": {
    "name": "Update conflict test",
    "project": "A project",
    "choices": {
      "uc_status": [
        {
          "value": "received",
          "label": "Received"
        },
        {
          "value": "with_pp",
          "label": "With PP"
        },
        {
          "value": "closed",
          "label": "Closed"
        }
      ]
    },
    "questions": [
      {
        "name": "header",
        "type": "string",
        "label": "Header"
      },
      {
        "name": "status",
        "type": "select1",
        "label": "Status",
        "option_list": "uc_status"
      },
      {
        "name": "a_note",
        "type": "string",
        "label": "Stage 1 note"
      }
    ],
    "groups": [
      {
        "name": "visits",
        "repeating": true,
        "label": "Visits",
        "questions": [
          {
            "name": "visit_note",
            "type": "string",
            "label": "Visit note"
          }
        ]
      }
    ]
  },
  "bundle": {
    "name": "Update conflict test stage 2",
    "questions": [
      {
        "name": "b_note",
        "type": "string",
        "label": "Stage 2 note"
      }
    ]
  },
  "scenarios": [
    {
      "name": "shared-header",
      "description": "Stage 2 is saved from a copy opened before stage 1 changed the status. Its unchanged copy of the status must not undo stage 1's change.",
      "steps": [
        {
          "save": "v1",
          "survey": "a",
          "answers": {
            "header": "h0",
            "status": "received",
            "a_note": "a0"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "save": "v2",
          "survey": "a",
          "opened": "v1",
          "answers": {
            "header": "h0",
            "status": "with_pp",
            "a_note": "a0"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "save": "v3",
          "survey": "b",
          "opened": "v1",
          "answers": {
            "header": "h0",
            "status": "received",
            "a_note": "a0",
            "b_note": "b1"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "expect": {
            "answers": {
              "header": "h0",
              "status": "with_pp",
              "a_note": "a0",
              "b_note": "b1"
            },
            "rows": [
              "x"
            ],
            "conflicts": 0
          }
        }
      ]
    },
    {
      "name": "real-conflict",
      "description": "Both stages change the status from the same version. The last save wins, a conflict is recorded, and reviewing it can put the other change back.",
      "steps": [
        {
          "save": "v1",
          "survey": "a",
          "answers": {
            "header": "h0",
            "status": "received",
            "a_note": "a0"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "save": "v2",
          "survey": "a",
          "opened": "v1",
          "answers": {
            "header": "h0",
            "status": "with_pp",
            "a_note": "a0"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "save": "v3",
          "survey": "b",
          "opened": "v1",
          "answers": {
            "header": "h0",
            "status": "closed",
            "a_note": "a0",
            "b_note": "b1"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "expect": {
            "answers": {
              "status": "closed",
              "b_note": "b1"
            },
            "conflicts": 1,
            "unresolved": 1,
            "items": [
              {
                "name": "status",
                "base": "received",
                "theirs": "with_pp",
                "mine": "closed"
              }
            ]
          }
        },
        {
          "resolve": {
            "0": "theirs"
          }
        },
        {
          "expect": {
            "answers": {
              "status": "with_pp",
              "b_note": "b1"
            },
            "unresolved": 0
          }
        }
      ]
    },
