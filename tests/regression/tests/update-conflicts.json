        {
          "save": "v1",
          "survey": "a",
          "answers": {
            "header": "h0",
            "status": "received",
            "a_note": "a0"
          },
          "rows": [
            {
              "visit_note": "x",
              "rowId": "r1"
            }
          ]
        },
        {
          "console": "c1",
          "opened": "v1",
          "updates": [
